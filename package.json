{
  "name": "specwriter-workspace",
  "private": true,
  "version": "0.11.0",
  "description": "Spec-driven long-form fiction with Codex and WriterMemory",
  "license": "MIT",
  "workspaces": ["packages/specwriter"],
  "scripts": {
    "build": "npm run build --workspace specwriter",
    "test": "npm run test --workspace specwriter",
    "check": "npm run check --workspace specwriter",
    "demo": "node packages/specwriter/examples/offline-demo.mjs",
    "demo:journey": "node packages/specwriter/examples/author-journey.mjs",
    "demo:long": "node packages/specwriter/examples/sustained-demo.mjs",
    "benchmark": "npm run build --workspace specwriter && node packages/specwriter/dist/cli.js benchmark run",
    "reader:demo": "node packages/specwriter/examples/reader-demo.mjs"
  }
}
