{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Historical verification draft; retrieval is material, never completed review",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "bookId", "stage", "scope", "history", "inputFingerprint", "preparedRevision", "binding", "query", "sources", "questions", "findings", "reviewed", "reviewNotes"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "bookId": { "type": "string", "minLength": 36, "maxLength": 36 },
    "stage": { "enum": ["plan", "review", "impact", "recap", "finish"] },
    "scope": { "type": "object", "additionalProperties": false, "required": ["workId", "chapter", "from", "to", "atChapter"], "properties": { "workId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "chapter": { "type": ["integer", "null"], "minimum": 1 }, "from": { "$ref": "#/$defs/boundary" }, "to": { "$ref": "#/$defs/boundary" }, "atChapter": { "$ref": "#/$defs/boundary" } } },
    "history": { "type": "object", "additionalProperties": false, "required": ["snapshotId", "atChapter", "chapters"], "properties": {
      "snapshotId": { "$ref": "#/$defs/hash" }, "atChapter": { "$ref": "#/$defs/boundary" },
      "chapters": { "type": "array", "maxItems": 10000, "items": { "type": "object", "additionalProperties": false, "required": ["chapter", "revision", "bodyHash", "deltaHash"], "properties": { "chapter": { "$ref": "#/$defs/positive" }, "revision": { "$ref": "#/$defs/positive" }, "bodyHash": { "$ref": "#/$defs/hash" }, "deltaHash": { "$ref": "#/$defs/hash" } } } }
    } },
    "inputFingerprint": { "$ref": "#/$defs/hash" }, "preparedRevision": { "$ref": "#/$defs/hash" },
    "binding": { "type": "object", "additionalProperties": false, "required": ["authorInputsHash", "providerConfigHash", "draftHash", "contextHash"], "properties": { "authorInputsHash": { "$ref": "#/$defs/hash" }, "providerConfigHash": { "$ref": "#/$defs/hash" }, "draftHash": { "$ref": "#/$defs/nullableHash" }, "contextHash": { "$ref": "#/$defs/nullableHash" } } },
    "query": { "type": "object", "additionalProperties": false, "required": ["text", "method", "engine", "answer", "receiptId", "snapshotId", "cached"], "properties": {
      "text": { "type": "string", "minLength": 1, "maxLength": 28000 }, "method": { "enum": ["local", "global", "drift", "basic", null] }, "engine": { "type": "string", "minLength": 1, "maxLength": 100 },
      "answer": { "type": "string", "maxLength": 30000 }, "receiptId": { "type": ["string", "null"], "maxLength": 200 }, "snapshotId": { "$ref": "#/$defs/nullableHash" }, "cached": { "type": ["boolean", "null"] }
    } },
    "sources": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/evidence" } },
    "questions": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text", "required"], "properties": { "id": { "type": "string", "pattern": "^q[1-9][0-9]?$" }, "text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" }, "required": { "const": true } } } },
    "findings": { "type": "array", "maxItems": 12, "items": { "type": "object", "additionalProperties": false, "required": ["questionId", "checked", "verdict", "conclusion", "evidence", "limitations"], "properties": {
      "questionId": { "type": "string", "pattern": "^q[1-9][0-9]?$" }, "checked": { "type": "boolean" }, "verdict": { "enum": ["supported", "uncertain", "conflicting", "not-applicable"] }, "conclusion": { "type": "string", "maxLength": 5000 },
      "evidence": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/evidence" } }, "limitations": { "$ref": "#/$defs/texts" }
    } } },
    "reviewed": { "type": "boolean" }, "reviewNotes": { "$ref": "#/$defs/texts" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }, "positive": { "type": "integer", "minimum": 1 }, "boundary": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "nullableHash": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "texts": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 3000, "pattern": "\\S" } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["chapter", "revision", "bodyHash", "quote"], "properties": { "chapter": { "$ref": "#/$defs/positive" }, "revision": { "$ref": "#/$defs/positive" }, "bodyHash": { "$ref": "#/$defs/hash" }, "quote": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }, "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 1 } } }
  }
}
