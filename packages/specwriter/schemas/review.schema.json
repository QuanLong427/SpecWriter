{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SpecWriter chapter review",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "chapter", "contextHash", "draftHash", "reviewed", "issues", "notes"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "chapter": { "type": "integer", "minimum": 1 },
    "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "draftHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checks": {
      "type": "object", "additionalProperties": false, "required": ["evidence", "coverage", "continuity"],
      "properties": { "evidence": { "$ref": "#/$defs/check" }, "coverage": { "$ref": "#/$defs/check" }, "continuity": { "$ref": "#/$defs/check" } }
    },
    "reviewed": { "type": "boolean" },
    "intent_checks": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "verdict", "evidenceQuotes", "explanation"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "verdict": { "enum": ["satisfied", "uncertain", "violated"] }, "evidenceQuotes": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "explanation": { "type": "string", "minLength": 1, "pattern": "\\S" } }
    } },
    "critical_checks": { "type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["claimHash", "verdict", "evidenceQuote", "explanation"],
      "properties": { "claimHash": { "$ref": "#/properties/draftHash" }, "verdict": { "enum": ["supported", "unsupported", "uncertain"] }, "evidenceQuote": { "type": "string", "minLength": 1 }, "explanation": { "type": "string", "minLength": 1, "pattern": "\\S" } }
    } },
    "retrieval_check": { "type": "object", "additionalProperties": false, "required": ["assessmentHash", "decision", "notes"], "properties": {
      "assessmentHash": { "$ref": "#/properties/draftHash" }, "decision": { "const": "use-formal-memory" }, "notes": { "type": "string", "minLength": 1, "pattern": "\\S" }
    } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "severity", "description", "resolved"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["continuity", "spec", "craft"] },
          "severity": { "enum": ["blocking", "warning", "suggestion"] },
          "description": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "resolved": { "type": "boolean" },
          "resolution": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [{ "if": { "properties": { "schemaVersion": { "const": 2 } } }, "then": { "properties": { "intentHash": { "$ref": "#/properties/intentHash" }, "checks": { "$ref": "#/properties/checks" } }, "required": ["intentHash", "checks"] } }],
  "$defs": {
    "check": { "type": "object", "additionalProperties": false, "required": ["checked", "notes"], "properties": {
      "checked": { "type": "boolean" }, "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
    } }
  }
}
